    "publish:repo": "node scripts/publish.mjs --push"
  },
  "dependencies": {
    "@opentelemetry/resources": "2.11.0",
    "applicationinsights": "3.17.0"
  },
  "devDependencies": {
    "@balena/dockerignore": "^1.0.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "parse5": "^8.0.1"
  }
